{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pagemind/ai-proxy/v1/ask-request",
  "title": "POST /v1/ask request (contract v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "enum": [
        "explain",
        "define",
        "translate",
        "ask",
        "summarize"
      ],
      "default": "explain"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "description": "Selected text. Required for every task except summarize."
    },
    "context": {
      "type": "string",
      "maxLength": 2000
    },
    "question": {
      "type": "string",
      "maxLength": 500
    },
    "language": {
      "type": "string",
      "maxLength": 40
    },
    "book_title": {
      "type": "string",
      "maxLength": 200
    },
    "book_author": {
      "type": "string",
      "maxLength": 200
    },
    "chapter": {
      "type": "string",
      "maxLength": 200,
      "description": "summarize: current chapter title or name, if known."
    },
    "text_before": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000,
      "description": "summarize: about 200 words ending at the reading position (end of the current page)."
    },
    "text_after": {
      "type": "string",
      "maxLength": 3000,
      "description": "summarize: about 200 words after the reading position, only for locating the scene; may be empty."
    }
  },
  "if": {
    "properties": {
      "task": {
        "const": "summarize"
      }
    },
    "required": [
      "task"
    ]
  },
  "then": {
    "required": [
      "text_before"
    ]
  },
  "else": {
    "required": [
      "text"
    ]
  }
}
